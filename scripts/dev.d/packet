#!/bin/sh
# Write .claude/review-packet.md: everything a reviewer needs about one PR, once.
#
#   scripts/dev packet <PR> [--since <sha>]
#
# Each of the three reviewers used to spend its first several turns on
# `gh pr view`, `gh issue view`, a full spec read and `gh pr diff` - every
# round, all three, separately (docs/plans/2026-09-harness-optimization.md,
# workstream C2). This writes it all to one gitignored file instead: PR
# title/body, the base/head branches and head SHA, the body of every issue
# the PR references, the spec sections the issue or PR names (never a whole
# spec file over 300 lines - see "spec sections" below), `git diff --stat`,
# the diff itself, a table of exported Go identifiers the diff adds or
# changes and whether each carries a doc comment, the test files touched,
# the PR's CI checks, and - on `--since` - the reviewer's own previous
# verdict comment for round >= 2.
#
#   --since <sha>   round >= 2: inline only the diff since <sha> (the
#                   previous round's reviewed head), plus the whole-PR
#                   diff --stat for context and a pointer to the full diff
#                   instead of inlining it. Per decision D9: a merge commit
#                   in <sha>..HEAD (the base branch was merged into this PR
#                   between rounds) turns a two-dot delta into upstream
#                   noise, so that case falls back to the full PR diff and
#                   says so.
#
# Spec sections: a spec file is named when its path appears in the issue or
# PR body. If the issue or PR body also names one of that spec's own
# headings (the heading's exact text is a substring of the combined issue +
# PR text, headings under 6 characters are ignored as too generic to match
# on purpose), only the named sections are included, each from its heading
# to the next heading of the same or higher level. If none of the file's
# headings are named: the whole file when it is 300 lines or fewer,
# otherwise the "Acceptance criteria" section plus the plain list of
# headings, with a line saying what was left out. A spec that is over 300
# lines and has no "Acceptance criteria" heading gets the headings list
# alone, with the same omission line.
#
# Every `gh` and `git` call is checked, and a failed one aborts with a
# message on stderr and a non-zero exit instead of leaving its section blank
# (#344). A section that says "(none)" or reports nothing found therefore
# means exactly that, never that the lookup fell over - the one exception is
# `gh pr checks`, whose own exit code is reported in the CI-status heading
# because a red or missing check is information a reviewer wants, not a
# reason to refuse to write the packet.
#
# The three reviewer prompts (.claude/agents/review-{go,tests,docs}.md) read
# this file as their first step instead of running the calls above
# themselves.
#
# POSIX sh and POSIX awk only (this runs under Git Bash on the host and
# under busybox sh/awk in the dev image, scripts/dev_test.go); no jq
# assumed - the JSON handling all goes through `gh ... --json ... -q`.
set -u

root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$root" || exit 1

help() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; }

pr=""
since=""
while [ $# -gt 0 ]; do
  case "$1" in
    --since)
      [ $# -ge 2 ] || { echo "packet: --since needs a commit SHA" >&2; exit 2; }
      since=$2; shift 2 ;;
    -h|--help) help; exit 0 ;;
    -*) echo "packet: unknown option $1" >&2; exit 2 ;;
    *)
      if [ -n "$pr" ]; then echo "packet: one PR number only" >&2; exit 2; fi
      pr=$1; shift ;;
  esac
done
if [ -z "$pr" ]; then
  echo "usage: scripts/dev packet <PR> [--since <sha>]" >&2
  exit 2
fi
case "$pr" in
  *[!0-9]*) echo "packet: '$pr' is not a PR number" >&2; exit 2 ;;
esac

mkdir -p .claude
out=.claude/review-packet.md

# Every `gh` and `git` call below is checked. An unchecked one leaves its
# section of the packet blank while the script still prints "wrote ..." and
# exits 0, and a reviewer has no way to tell that from a PR that genuinely
# has no body, no referenced issue or no test files - it reviews a hole
# (#344, item 1). The rule throughout: fail loudly on a call that failed,
# never on an empty result.
pr_field() {
  # $1 = the --json field name. Only the exit status can separate a failed
  # call from a legitimately empty value: a PR with no body answers `--json
  # body` with the empty string and exit 0, so `[ -n ... ]` would reject a
  # valid PR. The caller adds `|| exit 1` - `exit` here would only leave the
  # command substitution's subshell.
  gh pr view "$pr" --json "$1" -q ".$1" || {
    echo "packet: gh pr view $pr --json $1 failed" >&2
    return 1
  }
}

title=$(pr_field title) || exit 1
prbody=$(pr_field body) || exit 1
base=$(pr_field baseRefName) || exit 1
headref=$(pr_field headRefName) || exit 1
sha=$(pr_field headRefOid) || exit 1

# These three, unlike the body, are never legitimately empty: every PR has a
# base, a head branch and a head commit. An empty one means `gh` answered
# without failing, which the exit-status check above cannot catch.
if [ -z "$base" ] || [ -z "$headref" ] || [ -z "$sha" ]; then
  echo "packet: gh returned an empty base/head/SHA for PR $pr (base='$base' head='$headref' sha='$sha')" >&2
  exit 1
fi

git fetch origin "$base" --quiet 2>/dev/null || true
if git rev-parse -q --verify "origin/$base" >/dev/null 2>&1; then
  baseref="origin/$base"
elif git rev-parse -q --verify "$base" >/dev/null 2>&1; then
  baseref="$base"
else
  echo "packet: cannot find base branch '$base' locally or as origin/$base" >&2
  exit 1
fi

# --- issues the PR body references -----------------------------------------

# Excludes $pr itself: a PR's own "Implements #N" prose routinely also
# mentions its own number (this PR's "Size proof" section names #335), and
# GitHub's issue-view API answers a PR number too (issues and PRs share one
# number space), so without this exclusion the packet would inline the PR's
# own body a second time under a spurious "Issue #<PR>" heading.
issue_nums=$(printf '%s\n' "$prbody" | grep -Eo '#[0-9]+' | tr -d '#' | sort -un | grep -vx "$pr" || true)

issues_text=""
issues_section=""
for n in $issue_nums; do
  # A referenced number is checked against `gh pr view` first, not by letting
  # `gh issue view` fail: GitHub's issue-view API resolves PR numbers too (a
  # PR is an issue with a diff attached), so `gh issue view` on a PR number
  # succeeds and returns that PR's own body - it does not fail the way a
  # made-up or deleted number would.
  #
  # The failure of this call is read, not discarded (#344, item 1): `gh`
  # exits non-zero both for "this number is not a PR" - the answer the check
  # wants - and for a rate limit or a network blip, and treating the second
  # as the first would silently inline a PR's body under an "Issue #n"
  # heading. Only a message that looks like GitHub's not-found answer counts
  # as "not a PR"; anything else is reported in place of the issue body and
  # the lookup for that number stops there, so the packet says one thing
  # about #n rather than two.
  prcheck_err=$(gh pr view "$n" --json number 2>&1 >/dev/null)
  prcheck_rc=$?
  if [ "$prcheck_rc" -eq 0 ]; then
    issues_section="$issues_section
## #$n
(not an issue - #$n is a pull request)
"
    continue
  fi
  prcheck_err=$(printf '%s' "$prcheck_err" | tr '\n\r\t' '   ' | cut -c1-200)
  case "$prcheck_err" in
    *"Could not resolve to a PullRequest"*|*"no pull requests found"*|*"Could not resolve to a Pull Request"*) : ;;
    *)
      issues_section="$issues_section
## #$n
(could not be classified - \`gh pr view $n\` failed with something other than a not-found answer, so whether #$n is an issue or a pull request is unknown and its body was not read: $prcheck_err)
"
      continue ;;
  esac
  ibody=$(gh issue view "$n" --json body -q .body 2>/dev/null) || {
    issues_section="$issues_section
## #$n
(not an issue - #$n could not be read with \`gh issue view\`)
"
    continue
  }
  ititle=$(gh issue view "$n" --json title -q .title 2>/dev/null)
  issues_section="$issues_section
## Issue #$n: $ititle

$ibody
"
  issues_text="$issues_text
$ibody"
done

combined_text="$prbody
$issues_text"
# Whitespace-collapsed copy for heading matches: prose wraps a heading's own
# words across lines (this PR's body does exactly that to "No-host-toolchain
# constraint"), so a heading is "named" if its words appear in order with any
# run of whitespace between them, not only as an unbroken substring.
combined_norm=$(printf '%s' "$combined_text" | tr '\n\r\t' '   ' | tr -s ' ')

# --- spec sections -----------------------------------------------------------

spec_files=$(printf '%s' "$combined_text" | grep -Eo 'docs/specs/[0-9]+-[A-Za-z0-9._-]+\.md' | sort -u)

extract_section() {
  # $1 = file, $2 = exact heading text (no leading #'s)
  awk -v want="$2" '
    BEGIN { printing = 0; level = 0 }
    /^#+[ \t]/ {
      n = match($0, /^#+/); lvl = n>0 ? RLENGTH : 0
      line = $0
      sub(/^#+[ \t]*/, "", line)
      if (printing && lvl <= level) { printing = 0 }
      if (!printing && line == want) { printing = 1; level = lvl }
    }
    printing { print }
  ' "$1"
}

specs_section=""
if [ -n "$spec_files" ]; then
  for spec in $spec_files; do
    if [ ! -f "$spec" ]; then
      specs_section="$specs_section
### $spec
(named by the issue or PR, but not found in this checkout)
"
      continue
    fi

    total_lines=$(wc -l < "$spec" | tr -d ' ')
    headings=$(grep -n '^#\{1,6\}[ \t]' "$spec")

    # Headings and matches are read from real files, never from a heredoc: an
    # unquoted heredoc body is expanded for backticks and $ before `read`
    # ever sees it, and this project's spec headings are full of backtick-
    # quoted identifiers (e.g. `` `docker-compose.yml` ``) that would
    # otherwise be run as command substitutions.
    headings_file=$(mktemp)
    printf '%s\n' "$headings" > "$headings_file"
    matched_file=$(mktemp)
    : > "$matched_file"
    while IFS= read -r entry; do
      [ -n "$entry" ] || continue
      htext=${entry#*:}
      htext=$(printf '%s' "$htext" | sed -E 's/^#+[[:space:]]*//')
      [ ${#htext} -ge 6 ] || continue
      htext_norm=$(printf '%s' "$htext" | tr -s ' ')
      case "$combined_norm" in
        *"$htext_norm"*) printf '%s\n' "$htext" >> "$matched_file" ;;
      esac
    done < "$headings_file"

    if [ -s "$matched_file" ]; then
      specs_section="$specs_section
### $spec (named sections only; other headings omitted)
"
      while IFS= read -r htext; do
        [ -n "$htext" ] || continue
        specs_section="$specs_section
#### $htext

$(extract_section "$spec" "$htext")
"
      done < "$matched_file"
      rm -f "$headings_file" "$matched_file"
    elif [ "$total_lines" -le 300 ]; then
      rm -f "$headings_file" "$matched_file"
      specs_section="$specs_section
### $spec (whole file, $total_lines lines)

$(cat "$spec")
"
    else
      rm -f "$headings_file" "$matched_file"
      ac_heading=$(printf '%s\n' "$headings" | sed -E 's/^[0-9]+://' | grep -i -m 1 '^#\{1,6\}[ \t]*Acceptance criteria' || true)
      heading_list=$(printf '%s\n' "$headings" | sed -E 's/^[0-9]+:/  /')
      if [ -n "$ac_heading" ]; then
        ac_text=$(printf '%s' "$ac_heading" | sed -E 's/^#+[[:space:]]*//')
        specs_section="$specs_section
### $spec ($total_lines lines - over 300, no heading named: Acceptance criteria section + headings list only; the rest of the file was omitted)

#### $ac_text

$(extract_section "$spec" "$ac_text")

Headings in $spec:
$heading_list
"
      else
        specs_section="$specs_section
### $spec ($total_lines lines - over 300, no heading named and no Acceptance criteria section: headings list only; the file body was omitted)

Headings in $spec:
$heading_list
"
      fi
    fi
  done
fi

# --- diff --------------------------------------------------------------------

# Every `git` call here is checked too, for the same reason as the `gh` ones
# above (#344, item 1) and with one failure mode of its own: a reviewer's
# worktree that has not fetched the PR's very latest push has no object for
# $sha, so `git diff` fails and - unchecked - leaves an empty "## Diff"
# section behind a cheerful "wrote .claude/review-packet.md".
diff_fail() {
  echo "packet: $1 failed - is $sha fetched in this checkout? (git fetch origin $headref)" >&2
  rm -f "$inlined_diff_file"
  exit 1
}

full_stat=$(git diff --stat "$baseref...$sha") || {
  echo "packet: git diff --stat $baseref...$sha failed - is $sha fetched in this checkout? (git fetch origin $headref)" >&2
  exit 1
}

diff_note=""
inlined_diff_file=$(mktemp)
if [ -n "$since" ]; then
  # Not silenced: a `--since` SHA this checkout does not have fails here
  # first, and its own message is the useful one.
  merges=$(git log --oneline --merges "$since..$sha") || diff_fail "git log --merges $since..$sha"
  if [ -n "$merges" ]; then
    diff_note="--since $since found a merge commit in $since..$sha (the base branch was merged into this PR between rounds), so the full PR diff is inlined instead of the delta:
$merges
"
    git diff "$baseref...$sha" > "$inlined_diff_file" || diff_fail "git diff $baseref...$sha"
  else
    diff_note="Delta since the previous round's head ($since). The whole-PR diff --stat above covers everything changed since $base; the full PR diff is not inlined here - run \`git diff $baseref...$sha\` for it.
"
    git diff "$since..$sha" > "$inlined_diff_file" || diff_fail "git diff $since..$sha"
  fi
else
  git diff "$baseref...$sha" > "$inlined_diff_file" || diff_fail "git diff $baseref...$sha"
fi

# --- exported identifier table ------------------------------------------------

# A doc comment counts whether or not the diff added it (#344, item 2). The
# case that matters is a function whose signature or body changed under an
# existing, untouched doc comment: the comment is unified-diff *context* (a
# leading space, not a `+`), so counting only `+` comment lines reported the
# identifier as "doc comment: no" - a false "no" on exactly the shape a
# reviewer most wants signal about, since a changed signature under a stale
# doc comment is the docs reviewer's bread and butter. Hence `^[ +]` here and
# in the prefix strip below.
#
# Removed lines are skipped rather than resetting the pending comment: a
# changed signature's own `-func Foo(...)` line sits between the untouched
# doc comment and the new `+func Foo(...)`, and resetting on it would throw
# the comment away one line before it is needed. A `-// ...` line is ignored
# for the same reason it must be: a deleted doc comment documents nothing.
# Anything else - code, a blank context line, a hunk header - still resets,
# which keeps godoc's own rule that a blank line detaches a comment.
identifier_table=$(awk '
  BEGIN {
    print "| Identifier | Kind | Doc comment |"
    print "|---|---|---|"
    pending = 0
    top = ""
  }
  /^\+\+\+/ { pending = 0; top = ""; next }
  /^-/ { next }
  {
    line = $0
    if (match(line, /^[ +][ \t]*\/\//)) {
      if (pending == 0) { top = line }
      pending++
      next
    }
    name = ""; kind = ""
    if (match(line, /^\+[ \t]*func[ \t]+(\([^)]*\)[ \t]+)?[A-Z][A-Za-z0-9_]*\(/)) {
      s = substr(line, RSTART, RLENGTH)
      sub(/\($/, "", s)
      n = split(s, parts, /[ \t]/)
      name = parts[n]
      kind = "func"
    } else if (match(line, /^\+[ \t]*(type|var|const)[ \t]+[A-Z][A-Za-z0-9_]*/)) {
      s = substr(line, RSTART, RLENGTH)
      n = split(s, parts, /[ \t]/)
      kind = parts[1]
      sub(/^\+/, "", kind)
      name = parts[n]
    }
    if (name != "") {
      doc = "no"
      if (pending > 0) {
        cleaned = top
        sub(/^[ +][ \t]*\/\/[ \t]*/, "", cleaned)
        if (index(cleaned, name) == 1) {
          rest = substr(cleaned, length(name) + 1, 1)
          if (rest !~ /[A-Za-z0-9_]/) doc = "yes"
        }
      }
      printf "| %s | %s | %s |\n", name, kind, doc
    }
    pending = 0; top = ""
  }
' "$inlined_diff_file")

# --- test files changed --------------------------------------------------------

# Two steps, not one pipeline: `git diff | grep` reports grep's exit status,
# so a failed diff and a diff with no test files in it are the same "(none)"
# (#344, item 1). "(none)" must mean the PR changed no test file - the single
# most load-bearing line in the packet for the test reviewer - not that the
# lookup fell over.
changed_files=$(git diff --name-only "$baseref...$sha") || {
  echo "packet: git diff --name-only $baseref...$sha failed - is $sha fetched in this checkout? (git fetch origin $headref)" >&2
  rm -f "$inlined_diff_file"
  exit 1
}
test_files=$(printf '%s\n' "$changed_files" | grep -E '(_test\.go|\.test\.ps1)$' || true)
[ -n "$test_files" ] || test_files="(none)"
# The harness's own suites (scripts/tests/*.test.ps1, e.g.
# wellen-orchestrator.test.ps1, hooks.test.ps1) matter here too (#379): a PR
# whose only tests are PowerShell used to report "(none)" - false, and the
# single line review-tests leans on hardest - because the pattern above only
# knew Go's convention. review-tests' own toolset has no PowerShell, so it
# cannot run these even once they are correctly listed; say that explicitly
# rather than let a listed-but-unrunnable file read as "checked".
ps1_test_files=$(printf '%s\n' "$test_files" | grep '\.test\.ps1$' || true)

# --- CI status -----------------------------------------------------------------

ci_output=$(gh pr checks "$pr" 2>&1)
ci_rc=$?

# --- previous verdict (round >= 2) ----------------------------------------------
#
# Two ways to recognise a verdict comment below, and the second one is
# temporary.
#
# The first is H5's machine-readable marker (#304): the
# `<!-- verdict: ... reviewer=<role> -->` line each reviewer prompt's Output
# section ends with, and the only thing `scripts/dev gate` itself reads. That
# is the intended mechanism, and the lookup prefers it - the latest marker
# for a role wins.
#
# The second, matching the `## <X> Review` header text, exists only because
# H5 (#304) had not merged when this command shipped: PRs reviewed before it
# carry verdict comments with no marker in them at all (#344, item 3). It is
# a fallback for that history and nothing else. Every reviewer has emitted
# the marker since, so the header branch is already unreachable for any PR
# whose rounds all ran after H5 merged, and it becomes dead code outright
# once no caller can still be reviewing a pre-H5 PR - delete it then, along
# with `TestPacketSinceFindsThePreviousVerdictByTheHeaderFormat`.
#
# Until then the header text `## Go Review` / `## Test Review` /
# `## Docs Review` is load-bearing in the three prompts under
# `.claude/agents/`: reflowing or rewording a reviewer's header would
# silently stop round-2 packets from finding the previous verdict on any PR
# still on this path, with no error - the packet would simply report that it
# found none.
previous_section=""
if [ -n "$since" ]; then
  rs=$(printf '\036')
  # Checked like every other call (#344, item 1): the "(no previous verdict
  # comment found ...)" note below is an assertion about this PR's comments,
  # and it must not be printed when the truth is that they were never read.
  # `2>&1 >file`, in that order, splits the streams: stderr into the
  # substitution, stdout into the file.
  comments_file=$(mktemp)
  comments_err=$(gh pr view "$pr" --json comments -q '[.comments[].body] | join("\u001e")' 2>&1 >"$comments_file")
  comments_rc=$?
  comments=$(cat "$comments_file")
  rm -f "$comments_file"
  if [ "$comments_rc" -ne 0 ]; then
    comments_err=$(printf '%s' "$comments_err" | tr '\n\r\t' '   ' | cut -c1-200)
    previous_section="
(the previous round's verdict comments could NOT be read: \`gh pr view $pr --json comments\` failed: $comments_err. That is a lookup failure, not a statement that no verdict was posted - read the PR's own comment history before concluding anything about the previous round.)
"
    comments=""
  fi
  for role in "go:Go" "tests:Test" "docs:Docs"; do
    key=${role%%:*}
    header=${role#*:}
    verdict=$(printf '%s' "$comments" | awk -v RS="$rs" -v role="$key" -v header="$header" '
      {
        rec = $0
        if (match(rec, "<!-- verdict: (APPROVE|BLOCK) round=[0-9]+ sha=[0-9a-fA-F]+ reviewer=" role " -->")) {
          lastMarker = rec
        }
        if (match(rec, "^## " header " Review")) {
          lastHeader = rec
        }
      }
      END {
        if (lastMarker != "") { print lastMarker; exit }
        if (lastHeader != "") { print lastHeader }
      }
    ')
    if [ -n "$verdict" ]; then
      previous_section="$previous_section
### Previous $header review

$verdict
"
    elif [ "$comments_rc" -eq 0 ]; then
      # Per-role, not per-PR (#371): a role whose own comment is missing -
      # a transient `gh` failure, a race, or it truly never posted one -
      # used to get no subsection and no explicit signal, so its own round-2
      # "if you had no round-1 blocking findings, say that" instruction would
      # fire on silence even when the packet simply never found its comment.
      # State the miss for that role by name so it cannot be read as "clean
      # round 1" - this only fires when the lookup itself succeeded
      # ($comments_rc -eq 0); a failed lookup is already covered by the
      # message above and must not also claim nothing was found (#344, item 1).
      previous_section="$previous_section
### Previous $header review

(no previous verdict comment found for $key - this may be this role's first round, a transient lookup issue, or that it never posted one; read the PR's comment history directly for $key before concluding it had no round-1 blocking findings.)
"
    fi
  done
fi

# --- assemble ------------------------------------------------------------------

{
  echo "# Review packet - PR #$pr"
  echo
  echo "**Title:** $title"
  echo "**Base:** $base  ·  **Head:** $headref"
  echo "Head SHA: $sha"
  [ -z "$since" ] || echo "Since: $since"
  echo
  echo "## PR body"
  echo
  printf '%s\n' "$prbody"
  [ -z "$issues_section" ] || printf '%s\n' "$issues_section"
  [ -z "$specs_section" ] || { echo; echo "## Spec sections"; printf '%s\n' "$specs_section"; }
  echo
  echo "## Diff --stat (whole PR, $base -> head)"
  echo '```'
  printf '%s\n' "$full_stat"
  echo '```'
  echo
  echo "## Diff"
  [ -z "$diff_note" ] || printf '%s\n' "$diff_note"
  echo '```diff'
  cat "$inlined_diff_file"
  echo '```'
  echo
  echo "## Exported identifiers changed"
  printf '%s\n' "$identifier_table"
  echo
  echo "## Test files changed"
  printf '%s\n' "$test_files"
  if [ -n "$ps1_test_files" ]; then
    echo
    echo "(PowerShell suites above are not runnable from review-tests' own toolset - no PowerShell in it - so their pass/fail must come from the PR body or a run log, not from re-executing them here.)"
  fi
  echo
  echo "## CI status (gh pr checks, exit $ci_rc)"
  echo '```'
  printf '%s\n' "$ci_output"
  echo '```'
  [ -z "$previous_section" ] || { echo; echo "## Previous round's verdicts"; printf '%s\n' "$previous_section"; }
} > "$out"

rm -f "$inlined_diff_file"

echo "wrote $out"
