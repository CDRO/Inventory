#!/bin/sh
# Read reviewer verdicts back from a PR and decide MERGE, WAIT or BLOCK.
#
#   scripts/dev gate <PR>
#
# Replaces `ship/SKILL.md` step 6's "re-read every comment into context": the
# three reviewers (.claude/agents/review-{go,tests,docs}.md) each end their
# posted comment with one machine-readable line,
#   <!-- verdict: APPROVE|BLOCK round=<n> sha=<head sha reviewed> reviewer=go|tests|docs -->
# and this command greps for exactly that, never the prose above it. Only
# markers whose sha matches the PR's current head count; a marker for an
# older commit is stale and is dropped before the round is even computed, so
# a stale APPROVE can never outvote a fresh BLOCK and a re-review after a
# push starts the round count over for that commit. The *current round* is
# the highest round= among the markers that do match the head sha; within
# it, a reviewer's last marker wins over an earlier one at the same round
# (the reviewer corrected itself, or you re-ran it by hand).
#
# Prints one line per reviewer - `go: APPROVE r2 @abc1234` when it has a
# current verdict; `go: stale APPROVE r1 @def5678 (head is @abc1234)` when its
# only marker(s) are for an older commit or an earlier round than the other
# two reviewers reached; `go: missing` when it has never posted a marker at
# all - and then exactly one of:
#   MERGE                    all three APPROVE at the current round
#   WAIT <reviewers>         fewer than three markers for the head sha
#   BLOCK <reviewers>        any BLOCK among the current round's markers
# A stale or missing reviewer both count toward WAIT; neither ever counts as
# an approval.
#
# When all three approve and the PR's base is `main`, the `test` check on
# the head commit gates the MERGE too (decision D7,
# docs/plans/2026-09-harness-optimization.md §9):
#   CHECKS pending            the check is still running
#   CHECKS failed             the check failed
#   CHECKS missing            no check was ever reported, and either the diff
#                             is not documentation-only or the test reviewer's
#                             own **Suite:** line was not a local run — dispatch
#                             one with the command the message prints
# The one place this command reads prose rather than just the marker: the
# CHECKS-missing fallback's "test reviewer's own Suite line" above, which is
# looked up from the current round's own tests comment specifically (never a
# stale one), by decoding each comment on its own rather than from the same
# flattened text the vote count above uses.
# A base other than `main` needs no check at all (package PRs get no
# automatic run, docs/specs/01-architecture-and-deployment.md).
#
# A marker's sha= must be exactly 40 lowercase hex characters (a full git
# SHA, same shape `gh pr view --json headRefOid` returns). A malformed or
# truncated one - a reviewer prompt regressed, hand-edited a marker, or was
# interrupted mid-comment - is never silently treated as a stale marker: it
# would otherwise never equal any real head sha, so the affected reviewer
# would show as permanently stale/WAIT with no indication why. That is
# fixed by erroring loudly (exit 2) instead.
#
# Exit codes: 2 usage, initial lookup failure, or a malformed verdict marker;
# 0 MERGE; 3 WAIT or CHECKS pending/missing; 4 BLOCK or CHECKS failed.
set -u

help() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; }

case "${1:-}" in
  -h|--help) help; exit 0 ;;
esac
pr=${1:-}
case "$pr" in
  ''|*[!0-9]*)
    echo "usage: scripts/dev gate <PR>" >&2
    exit 2 ;;
esac

info=$(gh pr view "$pr" --json headRefOid,baseRefName -q '"\(.headRefOid)\t\(.baseRefName)"') || exit 2
head_sha=$(printf '%s' "$info" | cut -f1)
base_ref=$(printf '%s' "$info" | cut -f2)
short_sha=$(printf '%s' "$head_sha" | cut -c1-7)

comments=$(gh pr view "$pr" --json comments -q '.comments[].body' 2>/dev/null)

# Each marker line becomes "VERDICT ROUND SHA REVIEWER"; anything that is not
# a marker line (the prose above it, an unrelated comment) is dropped here so
# nothing later has to distinguish comments from each other. The guard regex
# recognizes anything marker-*shaped* (round=, sha=, reviewer= all present) so
# a structurally-valid marker whose sha is the wrong shape still reaches the
# length/charset check below instead of being silently dropped as if it were
# ordinary prose.
markers=$(printf '%s\n' "$comments" | awk '
  /^<!-- verdict: (APPROVE|BLOCK) round=[0-9]+ sha=[^ ]+ reviewer=(go|tests|docs) -->/ {
    line = $0
    sub(/^<!-- verdict: /, "", line)
    split(line, f, " ")
    v = f[1]
    round = f[2]; sub(/^round=/, "", round)
    sha = f[3]; sub(/^sha=/, "", sha)
    reviewer = f[4]; sub(/^reviewer=/, "", reviewer)
    if (sha !~ /^[0-9a-f]{40}$/) {
      print "gate: malformed verdict marker - sha is not 40 lowercase hex characters: " $0 > "/dev/stderr"
      bad = 1
      exit
    }
    print v, round, sha, reviewer
  }
  END { if (bad) exit 1 }')
if [ $? -ne 0 ]; then
  echo "gate: aborting - a reviewer's verdict marker is malformed (see stderr above)" >&2
  exit 2
fi

# latest[reviewer] is that reviewer's verdict at the current round for the
# head sha - the only thing that can make a reviewer count. last_any[reviewer]
# is its most recent marker regardless of sha or round, kept only so a
# reviewer that has posted before but not for this head/round can be shown as
# stale rather than indistinguishable from one that has never reviewed at all.
state=$(printf '%s\n' "$markers" | awk -v sha="$head_sha" '
  NF < 4 { next }
  { last_any[$4] = $1" "$2" "$3 }
  $3 == sha { if ($2 + 0 > maxround) maxround = $2 + 0; order[NR] = $1" "$2" "$4 }
  END {
    for (i = 1; i <= NR; i++) {
      if (order[i] == "") continue
      split(order[i], f, " ")
      if (f[2] + 0 == maxround) latest[f[3]] = f[1]
    }
    printf "round=%d\n", maxround
    for (r in latest) printf "%s=%s\n", r, latest[r]
    for (r in last_any) if (!(r in latest)) printf "stale_%s=%s\n", r, last_any[r]
  }')
round=$(printf '%s\n' "$state" | sed -n 's/^round=//p')
field() { printf '%s\n' "$state" | sed -n "s/^$1=//p"; }
go_v=$(field go); tests_v=$(field tests); docs_v=$(field docs)
go_stale=$(field stale_go); tests_stale=$(field stale_tests); docs_stale=$(field stale_docs)

missing=""
blocked=""
for pair in "go|$go_v|$go_stale" "tests|$tests_v|$tests_stale" "docs|$docs_v|$docs_stale"; do
  name=$(printf '%s' "$pair" | cut -d'|' -f1)
  v=$(printf '%s' "$pair" | cut -d'|' -f2)
  stale=$(printf '%s' "$pair" | cut -d'|' -f3)
  if [ -n "$v" ]; then
    echo "$name: $v r$round @$short_sha"
    [ "$v" = BLOCK ] && blocked="$blocked $name"
  elif [ -n "$stale" ]; then
    sv=$(printf '%s' "$stale" | cut -d' ' -f1)
    sr=$(printf '%s' "$stale" | cut -d' ' -f2)
    ss=$(printf '%s' "$stale" | cut -d' ' -f3 | cut -c1-7)
    echo "$name: stale $sv r$sr @$ss (head is @$short_sha)"
    missing="$missing $name"
  else
    echo "$name: missing"
    missing="$missing $name"
  fi
done

if [ -n "$blocked" ]; then
  echo "BLOCK${blocked}"
  exit 4
fi
if [ -n "$missing" ]; then
  echo "WAIT${missing}"
  exit 3
fi

if [ "$base_ref" != main ]; then
  echo MERGE
  exit 0
fi

bucket=$(gh pr checks "$pr" --json name,bucket -q '.[] | select(.name == "test") | .bucket' 2>/dev/null | tail -1)
case "$bucket" in
  pass) : ;;
  pending)
    echo "CHECKS pending"
    exit 3 ;;
  "")
    diff_files=$(git diff --name-only "origin/$base_ref...$head_sha" 2>/dev/null)
    if [ $? -ne 0 ]; then
      # Diff itself failed (no such ref locally, no repo): unknown is not
      # the same as docs-only, so this must not satisfy the fallback.
      ignored=0
    else
      ignored=1
      for f in $diff_files; do
        case "$f" in
          docs/*|*.md|.claude/*|LICENSE) ;;
          *) ignored=0 ;;
        esac
      done
    fi
    # The Suite line has to come from *this* round's tests comment, never any
    # earlier one - an old local run must not excuse a commit nobody has
    # re-reviewed. Comments are decoded one at a time (never flattened, the
    # way $markers/$comments are for the vote count above) so the marker at
    # the end of a comment and the Suite line inside that same comment can be
    # matched to each other and to nothing else.
    suite_local=0
    suite_line=$(gh pr view "$pr" --json comments -q '.comments[].body | @base64' 2>/dev/null | {
      want_a="<!-- verdict: APPROVE round=$round sha=$head_sha reviewer=tests -->"
      want_b="<!-- verdict: BLOCK round=$round sha=$head_sha reviewer=tests -->"
      found=""
      while IFS= read -r b64; do
        [ -n "$b64" ] || continue
        body=$(printf '%s' "$b64" | base64 -d 2>/dev/null)
        last_line=$(printf '%s\n' "$body" | tail -1)
        if [ "$last_line" = "$want_a" ] || [ "$last_line" = "$want_b" ]; then
          found=$(printf '%s\n' "$body" | grep -E '\*\*Suite:\*\*' | tail -1)
        fi
      done
      printf '%s' "$found"
    })
    if printf '%s' "$suite_line" | grep -qE 'exit [0-9]+'; then
      suite_local=1
    fi
    if [ "$ignored" -eq 1 ] && [ "$suite_local" -eq 1 ]; then
      : # docs-only diff, and the test reviewer's Suite line shows a local run
    else
      branch=$(gh pr view "$pr" --json headRefName -q .headRefName 2>/dev/null)
      echo "CHECKS missing — dispatch with scripts/dev ci-status $head_sha --dispatch $branch"
      exit 3
    fi ;;
  *)
    echo "CHECKS failed"
    exit 4 ;;
esac

echo MERGE
exit 0
