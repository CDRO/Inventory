# Canonical variable list for deploy/agent/docker-compose.agent.yml. Copy to
# deploy/agent/.env.agent (gitignored) and fill it in — see
# deploy/agent/README.md for how to obtain each value. A variable's note
# lives on the line above it, never after the value: Compose reads a '#'
# after an empty value as part of the value.
#
# REPO_PATH is NOT read from this file. Compose resolves the volume mount's
# ${REPO_PATH} before env_file below is ever applied inside the container, so
# it must be exported in your shell instead:
#   export REPO_PATH=$(pwd)   # from the repository root
# See the compose file's own comment on why the path must match the host's.

# --- Claude Code ---
# From `claude setup-token` on the HOST, run once, outside this container.
# A long-lived token — never commit it, never paste it into a chat.
CLAUDE_CODE_OAUTH_TOKEN=

# --- GitHub CLI ---
# `gh auth token` on the host, or a PAT with at least the `repo` scope
# (scripts/doctor checks for it).
GH_TOKEN=

# --- git identity ---
# Translated into `git config --global user.name`/`user.email` by
# entrypoint.sh — scripts/doctor's identity check reads config, not these
# variables directly.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# optional; defaults to the author identity above when left empty
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
