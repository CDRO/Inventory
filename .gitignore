# Local secrets — never committed (see docs/specs/01-architecture-and-deployment.md)
.env

# Runtime data of the Synology NAS variant (docker-compose.nas.yml). It lives in
# bind mounts inside the clone on purpose, so it must stay untracked: pgdata is
# the live database and ts_inventory_state holds the Tailscale node key. Anchored
# to the repository root, so internal/uploads (a Go package) is unaffected.
# Never run `git clean -x` or `-X` in a clone that holds this data - it would
# delete all of it.
/pgdata/
/uploads/
/imagecache/
/ts_inventory_state/

# Agent scratch state. Deliberately untracked: it is mid-task scratch only, it
# would conflict on every branch, and anything durable belongs in a GitHub
# issue or PR comment instead.
.claude/worklog.md
.claude/*.log
.claude/*.diff
.claude/*.txt
.claude/*.md

# Backup archives (docs/specs/15-backup-restore-and-export.md). The `backup`
# service writes them into ./backups inside the clone; they hold the whole
# database and every image in it, so they must never reach the repository.
/backups/

# Go build output
/inventory
*.exe

# Local data volumes
/data/

# E2E test runner artifacts (docs/specs/05-frontend-pwa-foundations.md).
# npm install runs inside the throwaway Playwright container on every
# invocation (see docker-compose.e2e.yml), writing into e2e/ through the bind
# mount; node_modules is never meant to persist on the host, and its symlinks
# have broken the app image's Docker build context when left behind.
e2e/node_modules/
e2e/package-lock.json
e2e/test-results/
e2e/playwright-report/

# Wave orchestrator run artifacts (scripts/wellen-orchestrator.ps1)
scripts/wellen-orchestrator.log
scripts/konsol-welle-*.started

# The self-hosted runner's registration (deploy/synology/runner/README.md). It
# lives in a bind mount inside the clone for the same reason the NAS runtime data
# above does, and it holds .credentials — the key this NAS authenticates to
# GitHub Actions with. Never committed. `git clean -x` in the clone deletes it;
# re-registering with a fresh one-hour token is the recovery.
/deploy/synology/runner/runner_state/

# The agent runtime's own secrets (deploy/agent/README.md): the OAuth token,
# GH_TOKEN and git identity that make deploy/agent/docker-compose.agent.yml's
# env_file work. Copied from .env.agent.example, never committed.
/deploy/agent/.env.agent
