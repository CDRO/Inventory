# Local secrets — never committed (see docs/specs/01-architecture-and-deployment.md)
.env

# Agent scratch state. Deliberately untracked: it is mid-task scratch only, it
# would conflict on every branch, and anything durable belongs in a GitHub
# issue or PR comment instead.
.claude/worklog.md
.claude/*.log
.claude/*.diff

# Go build output
/inventory
*.exe

# Local data volumes
/data/

# E2E test runner artifacts (docs/specs/05-frontend-pwa-foundations.md).
# npm install runs inside the throwaway Playwright container on every
# invocation (see docker-compose.e2e.yml), writing into e2e/ through the bind
# mount; node_modules is never meant to persist on the host, and its symlinks
# have broken the app image's Docker build context when left behind.
e2e/node_modules/
e2e/package-lock.json
e2e/test-results/
e2e/playwright-report/
