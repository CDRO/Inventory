# The NAS scripts are run by the Synology's busybox shell. A CRLF checkout (this
# repository is developed on Windows with core.autocrlf=true) would turn a
# shebang into "#!/bin/sh\r" and the script would stop running.
deploy/synology/compose text eol=lf
deploy/synology/install-shell text eol=lf
deploy/synology/update text eol=lf

# The backup/restore script runs in the postgres:16-alpine image's BusyBox
# shell (docs/specs/15-backup-restore-and-export.md), which has the same
# problem with a CRLF shebang. It is bind-mounted into the container straight
# from the checkout, so the checkout's line endings are the ones that run.
scripts/backup text eol=lf

# update_test.go writes the stub shell scripts it needs from Go raw string
# literals, so its own line endings end up in theirs. Go discards a \r inside a
# raw string literal, which would save it on a CRLF checkout anyway, but pinning
# the file is the version that does not depend on knowing that.
deploy/synology/update_test.go text eol=lf

# scripts/dev and its commands run under Git Bash, under the dev image's
# busybox sh (scripts/dev_test.go runs them there) and on a GitHub-hosted
# runner - the same CRLF shebang problem as the NAS scripts, and the same fix.
# dev_test.go is pinned for the reason update_test.go is.
scripts/dev text eol=lf
scripts/dev.d/* text eol=lf
scripts/dev_test.go text eol=lf

# scripts/doctor runs directly under sh (host, dev image busybox sh, GitHub
# runner) the same way scripts/dev does - same CRLF shebang problem.
scripts/doctor text eol=lf

# gate_test.go embeds gh/git stub scripts as raw string literals the same way
# dev_test.go and update_test.go do - same CRLF shebang problem, same fix.
scripts/gate_test.go text eol=lf
